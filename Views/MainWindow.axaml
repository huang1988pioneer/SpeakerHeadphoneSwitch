<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeakerHeadphoneSwitch.ViewModels"
        xmlns:models="using:SpeakerHeadphoneSwitch.Models"
        xmlns:converters="using:SpeakerHeadphoneSwitch.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="720"
        x:Class="SpeakerHeadphoneSwitch.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Title="聲音快捷切換"
        Width="560"
        Height="720"
        MinWidth="480"
        MinHeight="600">

    <Window.Resources>
        <converters:AssetImageConverter x:Key="AssetImage"/>
        <DataTemplate x:Key="DeviceItem" x:DataType="models:AudioOutputDevice">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Image Source="{Binding Icon, Converter={StaticResource AssetImage}}"
                       Width="20"
                       Height="20"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayName}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,30,34,28" Spacing="20">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="44"
                        Height="44"
                        CornerRadius="12"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Image Source="/Assets/app-icon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" Spacing="5">
                    <TextBlock Classes="heading" Text="聲音快捷切換" />
                    <TextBlock Classes="muted" Text="喇叭與耳機，一個按鈕完成切換" />
                </StackPanel>
                <Border Grid.Column="2"
                        Background="#1E2635"
                        CornerRadius="10"
                        Padding="11,7"
                        VerticalAlignment="Center">
                    <TextBlock Classes="muted" Text="{Binding PlatformDescription}" />
                </Border>
            </Grid>

            <Border Background="#181E2A" CornerRadius="18" Padding="22">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="56" Height="56"
                                Background="#28234F"
                                CornerRadius="16"
                                VerticalAlignment="Center">
                            <Image Source="{Binding CurrentDeviceIcon, Converter={StaticResource AssetImage}}"
                                   Width="44"
                                   Height="44"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,10,0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="muted" Text="目前輸出" />
                            <TextBlock Text="{Binding CurrentDeviceName}"
                                       Foreground="#F5F7FB"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" Text="{Binding CurrentDeviceType}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Classes="muted" Text="系統音量" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding CurrentVolumeText}"
                                       Foreground="#A99FFF"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#211F38" BorderBrush="#39345F" BorderThickness="1" CornerRadius="18" Padding="22">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="56" Height="56"
                                Background="#2B2554"
                                CornerRadius="16"
                                VerticalAlignment="Center">
                            <Image Source="{Binding TargetDeviceIcon, Converter={StaticResource AssetImage}}"
                                   Width="44"
                                   Height="44"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="muted" Text="下一個目的地" />
                            <TextBlock Text="{Binding TargetDeviceName}"
                                       Foreground="#F5F7FB"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" Text="{Binding TargetDeviceType}" />
                        </StackPanel>
                    </Grid>

                    <Button Classes="primary"
                            Command="{Binding ToggleOutputCommand}"
                            HorizontalContentAlignment="Center"
                            IsDefault="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Image Source="/Assets/icons/switch.png"
                                   Width="26"
                                   Height="26"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActionButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ProgressBar IsVisible="{Binding IsBusy}"
                                 IsIndeterminate="True"
                                 Height="4"
                                 Foreground="#A99FFF" />
                </StackPanel>
            </Border>

            <Border Background="#171D2A" BorderBrush="#303A50" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="預設裝置" Foreground="#DCE3F1" FontWeight="SemiBold" />
                            <TextBlock Text="指定一鍵切換時使用的四種目標；藍牙可分別指定喇叭或耳機。"
                                       Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="可選任一輸出"
                                   Classes="muted"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="/Assets/icons/speaker.png" Width="16" Height="16" Stretch="Uniform"/>
                                <TextBlock Text="預設喇叭" Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedSpeakerDevice, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DeviceItem}"
                                      MinHeight="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="/Assets/icons/headphones.png" Width="16" Height="16" Stretch="Uniform"/>
                                <TextBlock Text="預設耳機" Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedHeadphonesDevice, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DeviceItem}"
                                      MinHeight="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="/Assets/icons/speaker.png" Width="16" Height="16" Stretch="Uniform"/>
                                <TextBlock Text="預設藍牙喇叭" Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedBluetoothSpeakerDevice, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DeviceItem}"
                                      MinHeight="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="/Assets/icons/headphones.png" Width="16" Height="16" Stretch="Uniform"/>
                                <TextBlock Text="預設藍牙耳機" Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedBluetoothHeadphonesDevice, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DeviceItem}"
                                      MinHeight="34" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#171D2A" BorderBrush="#303A50" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="預設音量" Foreground="#DCE3F1" FontWeight="SemiBold" />
                        <TextBlock Text="切換完成後會將目標輸出設定為此音量（0–100%）。"
                                   Classes="muted"
                                   FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <NumericUpDown Value="{Binding TargetVolume, Mode=TwoWay}"
                                       Minimum="0"
                                       Maximum="100"
                                       Increment="1"
                                       FormatString="0"
                                       Width="86"
                                       Height="34"
                                       HorizontalContentAlignment="Right" />
                        <TextBlock Text="%" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#161B25" CornerRadius="14" Padding="18">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="流程"
                               Foreground="#DCE3F1"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{Binding TargetVolumeLabel}"
                               Classes="muted" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                               Margin="0,10,0,0"
                               Text="{Binding WorkflowDescription}"
                               Foreground="#A99FFF"
                               FontSize="14"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="可用輸出裝置" Classes="muted" />
                    <TextBlock Text="藍牙可為喇叭或耳機" Classes="muted" FontSize="11" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="ghost"
                        Command="{Binding RefreshCommand}"
                        Padding="13,8"
                        Content="重新整理" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AudioOutputDevice">
                        <Border Background="#181E2A" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Image Source="{Binding Icon, Converter={StaticResource AssetImage}}"
                                       Width="32"
                                       Height="32"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#E9EDF5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding KindLabel}" Classes="muted" />
                                </StackPanel>
                                <CheckBox Grid.Column="2"
                                          Content="藍牙"
                                          IsChecked="{Binding IsBluetooth, Mode=TwoWay}"
                                          ToolTip.Tip="藍牙裝置可以是喇叭，也可以是耳機"
                                          Foreground="#9CA7BA"
                                          VerticalAlignment="Center"
                                          Margin="8,0,12,0" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Id}"
                                           Classes="muted"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#172033" CornerRadius="12" Padding="15">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#DCE3F1"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusDetail}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</Window>
