<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeakerHeadphoneSwitch.ViewModels"
        xmlns:models="using:SpeakerHeadphoneSwitch.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="720"
        x:Class="SpeakerHeadphoneSwitch.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="聲音快捷切換"
        Width="560"
        Height="720"
        MinWidth="480"
        MinHeight="600">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,30,34,28" Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Classes="heading" Text="聲音快捷切換" />
                    <TextBlock Classes="muted" Text="喇叭與耳機，一個按鈕完成切換" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#1E2635"
                        CornerRadius="10"
                        Padding="11,7"
                        VerticalAlignment="Center">
                    <TextBlock Classes="muted" Text="{Binding PlatformDescription}" />
                </Border>
            </Grid>

            <Border Background="#181E2A" CornerRadius="18" Padding="22">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="56" Height="56"
                                Background="#28234F"
                                CornerRadius="16"
                                VerticalAlignment="Center">
                            <TextBlock Text="◉"
                                       FontSize="28"
                                       Foreground="#A99FFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,10,0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="muted" Text="目前輸出" />
                            <TextBlock Text="{Binding CurrentDeviceName}"
                                       Foreground="#F5F7FB"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" Text="{Binding CurrentDeviceType}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Classes="muted" Text="系統音量" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding CurrentVolumeText}"
                                       Foreground="#A99FFF"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#211F38" BorderBrush="#39345F" BorderThickness="1" CornerRadius="18" Padding="22">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="muted" Text="下一個目的地" />
                        <TextBlock Text="{Binding TargetDeviceName}"
                                   Foreground="#F5F7FB"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding TargetDeviceType}" />
                    </StackPanel>

                    <Button Classes="primary"
                            Command="{Binding ToggleOutputCommand}"
                            HorizontalContentAlignment="Center"
                            IsDefault="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="⇄" FontSize="22" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActionButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ProgressBar IsVisible="{Binding IsBusy}"
                                 IsIndeterminate="True"
                                 Height="4"
                                 Foreground="#A99FFF" />
                </StackPanel>
            </Border>

            <Border Background="#161B25" CornerRadius="14" Padding="18">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="流程"
                               Foreground="#DCE3F1"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="固定音量 33%"
                               Classes="muted" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                               Margin="0,10,0,0"
                               Text="必要時解除靜音  →  音量 0  →  切換  →  解除靜音  →  音量 33"
                               Foreground="#A99FFF"
                               FontSize="14"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="可用輸出裝置" Classes="muted" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="ghost"
                        Command="{Binding RefreshCommand}"
                        Padding="13,8"
                        Content="重新整理" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AudioOutputDevice">
                        <Border Background="#181E2A" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding Icon}"
                                           FontSize="20"
                                           Foreground="#A99FFF"
                                           VerticalAlignment="Center"
                                           Width="30" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#E9EDF5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding KindLabel}" Classes="muted" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Id}"
                                           Classes="muted"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#172033" CornerRadius="12" Padding="15">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#DCE3F1"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusDetail}"
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</Window>
