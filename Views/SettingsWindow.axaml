<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeakerHeadphoneSwitch.ViewModels"
        x:Class="SpeakerHeadphoneSwitch.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="設定"
        Icon="/Assets/AppIcon.png"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- 讓滑桿沿用應用程式的琥珀色強調色，而不是 Fluent 預設的系統藍。 -->
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F5B544" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFD166" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFD166" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#F5B544" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFD166" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFD166" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Border Margin="14"
            Padding="22"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <StackPanel Spacing="16">
            <StackPanel Spacing="5">
                <TextBlock Text="裝置設定" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="為每種目標指定要切換到的裝置。藍牙目標只列出藍牙裝置，喇叭與耳機只列出非藍牙裝置，並依種類篩選；選「自動選擇」則自動判斷。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Padding="17"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                    <TextBlock Classes="label" Text="喇叭" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SpeakerOptions}"
                              SelectedItem="{Binding Speaker}" />

                    <TextBlock Grid.Row="1" Classes="label" Text="耳機" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding HeadphoneOptions}"
                              SelectedItem="{Binding Headphone}" />

                    <TextBlock Grid.Row="2" Classes="label" Text="藍牙喇叭" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding BluetoothSpeakerOptions}"
                              SelectedItem="{Binding BluetoothSpeaker}" />

                    <TextBlock Grid.Row="3" Classes="label" Text="藍牙耳機" />
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              ItemsSource="{Binding BluetoothHeadphoneOptions}"
                              SelectedItem="{Binding BluetoothHeadphone}" />
                </Grid>
            </Border>

            <StackPanel Spacing="8">
                <StackPanel Spacing="3">
                    <TextBlock Text="音量設定" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="切換完成後套用到目標裝置的音量，預設 50%，可設定 0%–100%。設定為 0% 時只把音量歸零，不會把裝置標記為靜音。"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Padding="17,14"
                        Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <StackPanel Spacing="2">
                            <Slider Minimum="0"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding TargetVolume}"
                                    ToolTip.Tip="切換完成後要設定的音量（0%–100%）" />
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="0%"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="預設 50%"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="100%"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                        </StackPanel>
                        <Border Grid.Column="1"
                                MinWidth="64"
                                Padding="10,8"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="12"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TargetVolumeText}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentStrongBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasBluetoothDevices}">
                <StackPanel Spacing="3">
                    <TextBlock Text="藍牙裝置種類" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="藍牙裝置名稱常無法判斷是耳機還是喇叭，可在此手動標注；標注後會出現在對應的選單中。"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Padding="17,11"
                        Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <ItemsControl ItemsSource="{Binding BluetoothLabels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BluetoothDeviceLabel">
                                <Grid ColumnDefinitions="*,170" ColumnSpacing="12" Margin="0,5">
                                    <TextBlock Classes="label"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Choices}"
                                              SelectedItem="{Binding Selected}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <TextBlock Text="主視窗勾選「喇叭使用藍牙」「耳機使用藍牙」時，會改用對應的藍牙設定。"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" />

            <TextBlock Text="{Binding ConflictText}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="#FF8C8C"
                       IsVisible="{Binding !CanSave}" />

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Click="OnCancelClick" />
                <Button Classes="primary"
                        Content="儲存"
                        IsDefault="True"
                        IsEnabled="{Binding CanSave}"
                        Padding="22,10"
                        Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
